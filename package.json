{
  "name": "run",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @run/web dev",
    "build": "pnpm --filter @run/web build",
    "preview": "pnpm --filter @run/web preview",
    "typecheck": "pnpm --filter @run/web exec tsc -b",
    "test": "pnpm --filter @run/web test && node --experimental-strip-types --test tests/*.test.mjs && node scripts/sync-core.mjs --check",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@freeappstore/sdk": "^0.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
